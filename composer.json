{
  "name": "solophp/job-queue",
  "type": "library",
  "description": "A lightweight and reliable database-backed job queue for PHP with atomic claim, visibility timeout, and exponential backoff.",
  "keywords": [
    "php",
    "queue",
    "jobs",
    "scheduler",
    "async"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\JobQueue\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\JobQueue\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "doctrine/dbal": "^4.0",
    "solophp/contracts": "^1.4",
    "psr/container": "^1.0|^2.0",
    "psr/log": "^1.0|^2.0|^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "suggest": {
    "solophp/container": "PSR-11 container implementation for dependency injection",
    "solophp/logger": "PSR-3 compatible logger implementation"
  },
  "scripts": {
    "cs-check": "phpcs --standard=PSR12 src/",
    "cs-fix": "phpcbf --standard=PSR12 src/",
    "analyze": "phpstan analyse src --level=max",
    "test-unit": "phpunit",
    "test": [
      "@cs-check",
      "@analyze",
      "@test-unit"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
